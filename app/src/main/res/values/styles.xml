<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Learn how to setup this file at:
        https://github.com/jahirfiquitiva/Frames/wiki/Setting-custom-styles
    -->
    <style name="MyApp" />

    <!--
        Splash screen theme follow device's theme
    -->
    <style name="MyApp.SplashScreen" parent="Frames.SplashScreen">
        <item name="customFontBold">@font/manrope_bold_fam</item>
        <item name="customFontNormal">@font/manrope_normal_fam</item>
    </style>

    <!-- Default theme uses Material You as base -->
    <style name="MyApp.Default" parent="Blueprint.Default.MaterialYou">
        <item name="customFontBold">@font/manrope_bold_fam</item>
        <item name="customFontNormal">@font/manrope_normal_fam</item>
    </style>

    <!-- AMOLED theme uses Material You AMOLED as base -->
    <style name="MyApp.Default.Amoled" parent="Blueprint.Default.Amoled.MaterialYou">
        <item name="customFontBold">@font/manrope_bold_fam</item>
        <item name="customFontNormal">@font/manrope_normal_fam</item>
    </style>

    <!-- Theme for IconsCategoryActivity — no toolbar, clean icon grid -->
    <style name="MyApp.IconsGrid" parent="Theme.MaterialComponents.NoActionBar">
        <item name="customFontBold">@font/manrope_bold_fam</item>
        <item name="customFontNormal">@font/manrope_normal_fam</item>
    </style>

</resources>
